{
  "name": "typed-agent-service",
  "version": "0.1.0",
  "description": "Typed AI agent service: Fastify + Zod tool schemas + SSE streaming (learning project)",
  "main": "index.js",
  "scripts": {
    "test": "vitest run && vitest run --config web/vitest.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "demo": "tsx scripts/demo.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "keywords": [],
  "author": "James Kelly",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "fastify": "^5.10.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  }
}
