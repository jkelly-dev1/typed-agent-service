{
  "name": "typed-agent-service",
  "version": "0.1.0",
  "description": "Typed AI agent service: Fastify + Zod tool schemas + SSE streaming (learning project)",
  "scripts": {
    "test": "vitest run && vitest run --config web/vitest.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "demo": "tsx scripts/demo.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "keywords": [],
  "author": "James Kelly",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "fastify": "^5.12.5",
    "openai": "^6.49.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
